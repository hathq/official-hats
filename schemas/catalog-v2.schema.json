{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://official-hats/catalog/v2",
  "title": "Official HAT marketplace catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specification_schema",
    "signing_key_id",
    "origin",
    "categories",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "hathq://official-hats/catalog/v2"
    },
    "specification_schema": {
      "const": "hathq://hat/package/v2"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term_id",
        "ja",
        "en"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "term_id": {
          "type": "string",
          "pattern": "^hathq://vocabulary/data-domain/[a-z0-9-]+/v1$"
        },
        "ja": {
          "$ref": "#/$defs/localized"
        },
        "en": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "package_id",
        "version",
        "specification_version",
        "artifact_ref",
        "artifact_path",
        "package_sha256",
        "category_id",
        "assurance",
        "ja",
        "en"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^hat-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "package_id": {
          "type": "string",
          "pattern": "^hat/[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "specification_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "artifact_ref": {
          "type": "string",
          "pattern": "^hathq://official-hats/package/hat-[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^/catalog/v2/packages/hat-[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+/hat\\.package\\.json$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "category_id": {
          "$ref": "#/$defs/token"
        },
        "assurance": {
          "const": "official"
        },
        "residence_scopes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"
          }
        },
        "ja": {
          "$ref": "#/$defs/localized"
        },
        "en": {
          "$ref": "#/$defs/localized"
        }
      }
    }
  }
}
