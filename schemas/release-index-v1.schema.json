{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://official-hats/release-index/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specification_schema",
    "signing_key_id",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "hathq://official-hats/release-index/v1"
    },
    "specification_schema": {
      "const": "hathq://hat/package/v2"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "package_id",
          "version",
          "specification_version",
          "artifact_ref",
          "package_sha256"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^hat-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 128
          },
          "package_id": {
            "type": "string",
            "pattern": "^hat/[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 32
          },
          "specification_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 32
          },
          "artifact_ref": {
            "type": "string",
            "pattern": "^hathq://official-hats/package/hat-[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 256
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
